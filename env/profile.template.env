# shellcheck shell=bash
# Copy to env/<profile>.env and customize.

: "${USE_MODULES:=0}"
: "${MODULES_TO_UNLOAD:=}"
: "${MODULES_TO_LOAD:=}"

# Main compiler used by fpm install.
: "${FC:=gfortran}"

# Keep -fPIC because the archive is re-linked into a Python-loaded shared
# library after fpm install.
: "${FFLAGS:=-O3 -fPIC -fopenmp}"
: "${SHARED_LDFLAGS:=-fopenmp}"
